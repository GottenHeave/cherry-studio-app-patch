+    def test_rejects_wrong_file_metadata_and_bytes(self) -> None:
+        cases = [
+            ("wrong.bin", fixture.EXPECTED_MIME, fixture.EXPECTED_BYTES, "filename"),
+            (fixture.EXPECTED_FILENAME, "text/plain", fixture.EXPECTED_BYTES, "MIME"),
+            (fixture.EXPECTED_FILENAME, fixture.EXPECTED_MIME, b"wrong", "bytes"),
+        ]
+        for index, (filename, mime_type, data, expected_detail) in enumerate(cases):
+            with self.subTest(expected_detail=expected_detail):
+                boundary = f"clewdr-invalid-{index}"
+                status, payload = self._request(
+                    "POST",
+                    "/v1/files",
+                    _multipart(boundary, [("file", filename, mime_type, data)]),
