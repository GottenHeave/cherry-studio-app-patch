--- /dev/null
+++ b/app.config.ts
@@ -0,0 +1,60 @@
+import type { ExpoConfig } from 'expo/config';
+
+import appJson from './app.json';
+
+type ExpoPlugin = NonNullable<ExpoConfig['plugins']>[number];
+
+interface SmokeBuildEnvironment {
+  ci?: string;
+  runtimeSmoke?: string;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function enableAndroidCleartext(plugin: ExpoPlugin): ExpoPlugin {
+  if (!Array.isArray(plugin) || plugin[0] !== 'expo-build-properties') return plugin;
+  const options = isRecord(plugin[1]) ? plugin[1] : {};
+  const android = isRecord(options.android) ? options.android : {};
+  return [plugin[0], { ...options, android: { ...android, usesCleartextTraffic: true } }];
+}
+
+export function createExpoConfig(
+  config: ExpoConfig,
+  environment: SmokeBuildEnvironment,
+): ExpoConfig {
+  const ciEnabled = environment.ci === '1';
+  const smokeEnabled = ciEnabled && environment.runtimeSmoke === '1';
+  if (!smokeEnabled) {
+    return {
+      ...config,
+      extra: { ...config.extra, clewdrRuntimeSmokeCi: ciEnabled },
+    };
+  }
+
+  const transportSecurity = config.ios?.infoPlist?.NSAppTransportSecurity;
+  return {
+    ...config,
+    extra: { ...config.extra, clewdrRuntimeSmokeCi: true },
+    ios: {
+      ...config.ios,
+      infoPlist: {
+        ...config.ios?.infoPlist,
+        NSAppTransportSecurity: {
+          ...(isRecord(transportSecurity) ? transportSecurity : {}),
+          NSAllowsLocalNetworking: true,
+        },
+      },
+    },
+    plugins: config.plugins?.map(enableAndroidCleartext),
+  };
+}
+
+const staticConfig = appJson.expo as ExpoConfig;
+
+export default (): ExpoConfig =>
+  createExpoConfig(staticConfig, {
+    ci: process.env.CI,
+    runtimeSmoke: process.env.EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE,
+  });
diff --git a/scripts/ci/clewdr-runtime-smoke.sh b/scripts/ci/clewdr-runtime-smoke.sh
new file mode 100755
index 0000000..3ab250e
--- /dev/null
+++ b/scripts/ci/clewdr-runtime-smoke.sh
@@ -0,0 +1,148 @@
+#!/usr/bin/env bash
+
+set -euo pipefail
+
+platform="${1:-}"
+if [[ "$platform" != "android" && "$platform" != "ios" ]]; then
+  echo "usage: $0 android|ios" >&2
+  exit 2
+fi
+
+repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
+fixture="$repo_root/scripts/ci/clewdr_runtime_fixture.py"
+tmp_dir="$(mktemp -d)"
+port_file="$tmp_dir/fixture-port"
+fixture_log="$tmp_dir/fixture.log"
+build_log="$tmp_dir/native-build.log"
+fixture_pid=""
+
+cleanup() {
+  if [[ -n "$fixture_pid" ]]; then
+    kill "$fixture_pid" 2>/dev/null || true
+    wait "$fixture_pid" 2>/dev/null || true
+  fi
+  rm -rf "$tmp_dir"
+}
+trap cleanup EXIT
+
+dump_native_logs() {
+  if [[ "$platform" == "android" ]]; then
+    adb -s "$device" logcat -d -t 500 2>/dev/null || true
+  else
+    xcrun simctl spawn "$device" log show --last 5m --style compact \
+      --predicate 'process == "Cherry Studio" OR eventMessage CONTAINS[c] "clewdr"' 2>/dev/null || true
+  fi
+}
+
+for command_name in python3 pnpm curl; do
+  if ! command -v "$command_name" >/dev/null; then
+    echo "required command not found: $command_name" >&2
+    exit 1
+  fi
+done
+
+cd "$repo_root"
+python3 -m unittest scripts/ci/test_clewdr_runtime_fixture.py
+python3 "$fixture" --port 0 --port-file "$port_file" >"$fixture_log" 2>&1 &
+fixture_pid=$!
+
+for ((attempt = 0; attempt < 50; attempt++)); do
+  [[ -s "$port_file" ]] && break
+  kill -0 "$fixture_pid" 2>/dev/null || {
+    cat "$fixture_log" >&2
+    exit 1
+  }
+  sleep 0.1
+done
+if [[ ! -s "$port_file" ]]; then
+  echo "fixture did not publish its port" >&2
+  exit 1
+fi
+port="$(cat "$port_file")"
+
+if [[ "$platform" == "android" ]]; then
+  command -v adb >/dev/null || {
+    echo "adb is required for Android runtime smoke" >&2
+    exit 1
+  }
+  if [[ -n "${ANDROID_SERIAL:-}" ]]; then
+    device="$ANDROID_SERIAL"
+  else
+    mapfile -t devices < <(adb devices | awk '$2 == "device" { print $1 }')
+    if [[ "${#devices[@]}" -ne 1 ]]; then
+      echo "expected exactly one running Android device; set ANDROID_SERIAL when multiple devices are connected" >&2
+      exit 1
+    fi
+    device="${devices[0]}"
+  fi
+  if [[ "$(adb -s "$device" get-state 2>/dev/null)" != "device" ]]; then
+    echo "Android device is not ready: $device" >&2
+    exit 1
+  fi
+  abi="$(adb -s "$device" shell getprop ro.product.cpu.abi | tr -d '\r')"
+  case "$abi" in
+    arm64-v8a | x86_64 | x86) ;;
+    *)
+      echo "unsupported Android emulator ABI: $abi" >&2
+      exit 1
+      ;;
+  esac
+  device_endpoint="http://10.0.2.2:$port"
+  EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE=1 CI=1 pnpm exec expo prebuild --platform android --no-install
+  if grep -q '^reactNativeArchitectures=' android/gradle.properties; then
+    sed -i.bak -E "s/^reactNativeArchitectures=.*/reactNativeArchitectures=$abi/" android/gradle.properties
+  else
+    printf '\nreactNativeArchitectures=%s\n' "$abi" >>android/gradle.properties
+  fi
+  rm -f android/gradle.properties.bak
+  EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE=1 CI=1 pnpm exec expo run:android \
+    --variant release --no-bundler --device "$device" 2>&1 | tee "$build_log"
+else
+  command -v xcrun >/dev/null || {
+    echo "xcrun is required for iOS runtime smoke" >&2
+    exit 1
+  }
+  device="$(xcrun simctl list devices booted --json | python3 -c '
+import json, sys
+devices = [device["udid"] for runtime in json.load(sys.stdin)["devices"].values() for device in runtime if device["state"] == "Booted"]
+if len(devices) != 1:
+    raise SystemExit("expected exactly one booted iOS Simulator")
+print(devices[0])
+')"
+  xcrun simctl getenv "$device" HOME >/dev/null
+  device_endpoint="http://localhost:$port"
+  EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE=1 CI=1 pnpm exec expo prebuild --platform ios --no-install
+  EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE=1 CI=1 pnpm exec expo run:ios \
+    --configuration Release --no-bundler --device "$device" 2>&1 | tee "$build_log"
+fi
+
+encoded_endpoint="$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$device_endpoint")"
+smoke_url="cherrystudio://clewdr-runtime-smoke?endpoint=$encoded_endpoint"
+if [[ "$platform" == "android" ]]; then
+  adb -s "$device" shell am start -W -a android.intent.action.VIEW -d "$smoke_url" \
+    -p com.cherry_ai.cherry_studio_app >/dev/null
+else
+  xcrun simctl openurl "$device" "$smoke_url"
+fi
+
+for ((attempt = 0; attempt < 90; attempt++)); do
+  status_json="$(curl --fail --silent --show-error "http://127.0.0.1:$port/status")"
+  status="$(python3 -c 'import json, sys; print(json.load(sys.stdin)["status"])' <<<"$status_json")"
+  if [[ "$status" == "success" ]]; then
+    echo "Clewdr $platform native runtime smoke passed"
+    exit 0
+  fi
+  if [[ "$status" == "failure" ]]; then
+    echo "$status_json" >&2
+    cat "$fixture_log" >&2
+    dump_native_logs
+    exit 1
+  fi
+  sleep 2
+done
+
+echo "Clewdr $platform native runtime smoke timed out" >&2
+cat "$fixture_log" >&2
+cat "$build_log" >&2
+dump_native_logs
+exit 1
diff --git a/scripts/ci/clewdr_runtime_fixture.py b/scripts/ci/clewdr_runtime_fixture.py
new file mode 100755
index 0000000..eb8b014
--- /dev/null
+++ b/scripts/ci/clewdr_runtime_fixture.py
@@ -0,0 +1,275 @@
+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import argparse
+import json
+import threading
+from email import policy
+from email.parser import BytesParser
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from pathlib import Path
+from typing import Any
+
+EXPECTED_BYTES = b"CLEWDR"
+EXPECTED_FILENAME = "clewdr-runtime-smoke.bin"
+EXPECTED_MIME = "application/octet-stream"
+FILE_ID = "file_clewdr_v1_runtime_smoke"
+EXPECTED_ANSWER = "runtime smoke ok"
+EXPECTED_API_KEY = "ci-runtime-smoke"
+EXPECTED_MODEL = "claude-runtime-smoke"
+
+
+class FixtureState:
+    def __init__(self) -> None:
+        self.lock = threading.Lock()
+        self.upload_received = False
+        self.message_received = False
+        self.upload_count = 0
+        self.message_count = 0
+        self.result_count = 0
+        self.status = "pending"
+        self.detail = "waiting for native app"
+
+    def fail(self, detail: str) -> None:
+        with self.lock:
+            self.status = "failure"
+            self.detail = detail
+
+    def snapshot(self) -> dict[str, Any]:
+        with self.lock:
+            return {
+                "status": self.status,
+                "detail": self.detail,
+                "uploadCount": self.upload_count,
+                "messageCount": self.message_count,
+                "resultCount": self.result_count,
+            }
+
+
+class SmokeServer(ThreadingHTTPServer):
+    def __init__(self, address: tuple[str, int]) -> None:
+        super().__init__(address, FixtureHandler)
+        self.state = FixtureState()
+
+
+class FixtureHandler(BaseHTTPRequestHandler):
+    server: SmokeServer
+
+    def do_GET(self) -> None:
+        if self.path != "/status":
+            self._json_response(404, {"error": "not_found"})
+            return
+        self._json_response(200, self.server.state.snapshot())
+
+    def do_POST(self) -> None:
+        try:
+            if self.path == "/v1/files":
+                self._handle_file_upload()
+            elif self.path == "/v1/messages":
+                self._handle_messages()
+            elif self.path == "/result":
+                self._handle_result()
+            else:
+                self._json_response(404, {"error": "not_found"})
+        except (ValueError, json.JSONDecodeError) as error:
+            self.server.state.fail(str(error))
+            self._json_response(400, {"error": "invalid_smoke_request", "detail": str(error)})
+
+    def _handle_file_upload(self) -> None:
+        self._validate_api_key()
+        content_type = self.headers.get("content-type", "")
+        body = self._read_body()
+        message = BytesParser(policy=policy.default).parsebytes(
+            f"Content-Type: {content_type}\r\nMIME-Version: 1.0\r\n\r\n".encode() + body
+        )
+        if message.get_content_type() != "multipart/form-data" or not message.is_multipart():
+            raise ValueError("upload must be multipart/form-data")
+
+        parts = list(message.iter_parts())
+        if len(parts) != 1:
+            raise ValueError("upload must contain exactly one multipart field")
+        part = parts[0]
+        if part.get_param("name", header="content-disposition") != "file":
+            raise ValueError("multipart field must be named file")
+        if part.get_filename() != EXPECTED_FILENAME:
+            raise ValueError("unexpected upload filename")
+        if part.get_content_type() != EXPECTED_MIME:
+            raise ValueError("unexpected upload MIME type")
+        if part.get_payload(decode=True) != EXPECTED_BYTES:
+            raise ValueError("unexpected upload bytes")
+
+        with self.server.state.lock:
+            self.server.state.upload_received = True
+            self.server.state.upload_count += 1
+        self._json_response(
+            200,
+            {
+                "id": FILE_ID,
+                "type": "file",
+                "filename": EXPECTED_FILENAME,
+                "mime_type": EXPECTED_MIME,
+                "size_bytes": len(EXPECTED_BYTES),
+            },
+        )
+
+    def _handle_messages(self) -> None:
+        self._validate_api_key()
+        payload = json.loads(self._read_body())
+        with self.server.state.lock:
+            upload_received = self.server.state.upload_received
+        if not upload_received:
+            raise ValueError("message arrived before upload")
+        if "tools" in payload or "tool_choice" in payload:
+            raise ValueError("Clewdr request must strip tools")
+        if payload.get("model") != EXPECTED_MODEL:
+            raise ValueError("message uses an unexpected model")
+        metadata = payload.get("metadata")
+        if not isinstance(metadata, dict) or not str(metadata.get("user_id", "")).startswith(
+            "cherry_topic_v1_"
+        ):
+            raise ValueError("message is missing the explicit session ID")
+        messages = payload.get("messages")
+        if not _contains_exact_user_document(messages, FILE_ID):
+            raise ValueError("message does not contain the exact staged document source")
+        if _contains_base64_source(messages):
+            raise ValueError("message still contains a base64 source")
+
+        with self.server.state.lock:
+            self.server.state.message_received = True
+            self.server.state.message_count += 1
+        events = [
+            {"type": "conversation_ready"},
+            {
+                "type": "message_start",
+                "message": {
+                    "id": "msg_smoke",
+                    "model": "claude-runtime-smoke",
+                    "role": "assistant",
+                    "content": [],
+                    "usage": {"input_tokens": 1},
+                },
+            },
+            {
+                "type": "content_block_start",
+                "index": 0,
+                "content_block": {"type": "text", "text": ""},
+            },
+            {
+                "type": "content_block_delta",
+                "index": 0,
+                "delta": {"type": "text_delta", "text": EXPECTED_ANSWER},
+            },
+            {"type": "content_block_stop", "index": 0},
+            {
+                "type": "message_delta",
+                "delta": {"stop_reason": "end_turn", "stop_sequence": None},
+                "usage": {"output_tokens": 3},
+            },
+            {"type": "message_stop"},
+        ]
+        body = "".join(
+            f"data: {json.dumps(event, separators=(',', ':'))}\n\n" for event in events
+        ).encode()
+        self.send_response(200)
+        self.send_header("content-type", "text/event-stream")
+        self.send_header("content-length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def _handle_result(self) -> None:
+        payload = json.loads(self._read_body())
+        if payload.get("status") != "success":
+            raise ValueError(f"native runner failed: {payload.get('error', 'unknown error')}")
+        if payload.get("answer") != EXPECTED_ANSWER:
+            raise ValueError("native runner returned an unexpected answer")
+        raw_types = payload.get("rawTypes")
+        if not isinstance(raw_types, list) or "conversation_ready" not in raw_types:
+            raise ValueError("native runner did not consume the Clewdr extension event")
+        with self.server.state.lock:
+            request_counts = (
+                self.server.state.upload_count,
+                self.server.state.message_count,
+                self.server.state.result_count,
+            )
+        if request_counts != (1, 1, 0):
+            raise ValueError("native runner used unexpected fixture request counts")
+        with self.server.state.lock:
+            self.server.state.result_count += 1
+            self.server.state.status = "success"
+            self.server.state.detail = "native multipart upload and stream completed"
+        self._json_response(200, {"ok": True})
+
+    def _validate_api_key(self) -> None:
+        if self.headers.get("x-api-key") != EXPECTED_API_KEY:
+            raise ValueError("request is missing the expected x-api-key")
+
+    def _read_body(self) -> bytes:
+        length = int(self.headers.get("content-length", "0"))
+        if length <= 0 or length > 1024 * 1024:
+            raise ValueError("request body length is invalid")
+        body = self.rfile.read(length)
+        if len(body) != length:
+            raise ValueError("request body ended early")
+        return body
+
+    def _json_response(self, status: int, payload: dict[str, Any]) -> None:
+        body = json.dumps(payload).encode()
+        self.send_response(status)
+        self.send_header("content-type", "application/json")
+        self.send_header("content-length", str(len(body)))
+        self.end_headers()
+        self.wfile.write(body)
+
+    def log_message(self, format_string: str, *args: object) -> None:
+        return
+
+
+def _contains_exact_user_document(value: Any, file_id: str) -> bool:
+    if not isinstance(value, list):
+        return False
+    expected_source = {"type": "file", "file_id": file_id}
+    for message in value:
+        if not isinstance(message, dict) or message.get("role") != "user":
+            continue
+        content = message.get("content")
+        if not isinstance(content, list):
+            continue
+        if any(
+            isinstance(part, dict)
+            and part.get("type") == "document"
+            and part.get("source") == expected_source
+            for part in content
+        ):
+            return True
+    return False
+
+
+def _contains_base64_source(value: Any) -> bool:
+    if isinstance(value, dict):
+        if value.get("type") == "base64":
+            return True
+        return any(_contains_base64_source(child) for child in value.values())
+    if isinstance(value, list):
+        return any(_contains_base64_source(child) for child in value)
+    return False
+
+
+def create_server(host: str, port: int) -> SmokeServer:
+    return SmokeServer((host, port))
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--host", default="0.0.0.0")
+    parser.add_argument("--port", type=int, default=0)
+    parser.add_argument("--port-file", type=Path, required=True)
+    args = parser.parse_args()
+
+    server = create_server(args.host, args.port)
+    args.port_file.write_text(str(server.server_address[1]), encoding="utf-8")
+    server.serve_forever()
+
+
+if __name__ == "__main__":
+    main()
