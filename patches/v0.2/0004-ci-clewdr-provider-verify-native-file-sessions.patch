@@ -0,0 +1,45 @@
+import Constants from 'expo-constants';
+import { type ReactNode, useEffect, useState } from 'react';
+import { ActivityIndicator, Linking } from 'react-native';
+
+import {
+  type ClewdrRuntimeSmokeOptions,
+  parseClewdrRuntimeSmokeUrl,
+  runClewdrRuntimeSmoke,
+} from '@/ai/runtime/clewdrRuntimeSmoke';
+
+interface ClewdrRuntimeSmokeGateProps {
+  children: ReactNode;
+}
+
+export function isClewdrRuntimeSmokeEnabled(
+  publicFlag = process.env.EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE,
+  ciFlag = Constants.expoConfig?.extra?.clewdrRuntimeSmokeCi === true,
+): boolean {
+  return publicFlag === '1' && ciFlag;
+}
+
+export function ClewdrRuntimeSmokeGate({ children }: ClewdrRuntimeSmokeGateProps) {
+  const [smokeOptions, setSmokeOptions] = useState<ClewdrRuntimeSmokeOptions | null>(null);
+  const enabled = isClewdrRuntimeSmokeEnabled();
+
+  useEffect(() => {
+    if (!enabled) return;
+
+    const acceptUrl = (url: string | null) => {
+      if (!url) return;
+      const options = parseClewdrRuntimeSmokeUrl(url);
+      if (options) setSmokeOptions(options);
+    };
+    const subscription = Linking.addEventListener('url', (event) => acceptUrl(event.url));
+    void Linking.getInitialURL().then(acceptUrl);
+    return () => subscription.remove();
+  }, [enabled]);
+
+  useEffect(() => {
+    if (enabled && smokeOptions) void runClewdrRuntimeSmoke(smokeOptions);
+  }, [enabled, smokeOptions]);
+
+  if (enabled && smokeOptions) return <ActivityIndicator size="large" />;
+  return <>{children}</>;
+}
