+                "messages": [
+                    {
+                        "role": "user",
+                        "content": [
+                            {
+                                "type": "document",
+                                "source": {"type": "file", "file_id": fixture.FILE_ID},
+                            }
+                        ]
+                    }
+                ],
+                "metadata": {"user_id": "cherry_topic_v1_test"},
+                "model": fixture.EXPECTED_MODEL,
+            }
+        ).encode()
+        self.connection.request(
+            "POST",
+            "/v1/messages",
+            message,
+            {"content-type": "application/json", "x-api-key": fixture.EXPECTED_API_KEY},
+        )
+        response = self.connection.getresponse()
+        stream_body = response.read().decode()
+        self.assertEqual(response.status, 200)
+        self.assertIn("conversation_ready", stream_body)
+        self.assertIn(fixture.EXPECTED_ANSWER, stream_body)
+
+        result = json.dumps(
+            {
+                "status": "success",
+                "answer": fixture.EXPECTED_ANSWER,
+                "rawTypes": ["conversation_ready"],
+            }
+        ).encode()
+        status, payload = self._request(
+            "POST", "/result", result, {"content-type": "application/json"}
