+import type { ExpoConfig } from 'expo/config';
+
+import { createExpoConfig } from './app.config';
+
+const baseConfig: ExpoConfig = {
+  ios: { infoPlist: { ExistingKey: true } },
+  name: 'Cherry Studio',
+  plugins: [['expo-build-properties', { ios: { deploymentTarget: '17.0' } }]],
+  slug: 'cherry-studio',
+};
+
+describe('Clewdr runtime smoke Expo config', () => {
+  it('keeps local transport exceptions out of normal and non-CI builds', () => {
+    for (const environment of [
+      { ci: undefined, runtimeSmoke: undefined },
+      { ci: undefined, runtimeSmoke: '1' },
+      { ci: '1', runtimeSmoke: undefined },
+    ]) {
+      const config = createExpoConfig(baseConfig, environment);
+      expect(config.ios?.infoPlist).toEqual({ ExistingKey: true });
+      expect(config.plugins).toEqual(baseConfig.plugins);
+    }
+  });
+
+  it('enables local HTTP only for the CI smoke build', () => {
+    const config = createExpoConfig(baseConfig, { ci: '1', runtimeSmoke: '1' });
+
+    expect(config.extra?.clewdrRuntimeSmokeCi).toBe(true);
+    expect(config.ios?.infoPlist).toMatchObject({
+      ExistingKey: true,
+      NSAppTransportSecurity: { NSAllowsLocalNetworking: true },
+    });
+    expect(config.plugins).toContainEqual([
+      'expo-build-properties',
+      {
+        android: { usesCleartextTraffic: true },
+        ios: { deploymentTarget: '17.0' },
+      },
+    ]);
+  });
+});
diff --git a/app.config.ts b/app.config.ts
