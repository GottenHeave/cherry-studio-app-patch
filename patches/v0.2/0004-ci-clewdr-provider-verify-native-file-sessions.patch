+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import http.client
+import importlib.util
+import json
+import threading
+import unittest
+from pathlib import Path
+
+FIXTURE_PATH = Path(__file__).with_name("clewdr_runtime_fixture.py")
+SPEC = importlib.util.spec_from_file_location("clewdr_runtime_fixture", FIXTURE_PATH)
+assert SPEC and SPEC.loader
+fixture = importlib.util.module_from_spec(SPEC)
+SPEC.loader.exec_module(fixture)
+
+
+class ClewdrRuntimeFixtureTest(unittest.TestCase):
+    def setUp(self) -> None:
+        self.server = fixture.create_server("127.0.0.1", 0)
+        self.thread = threading.Thread(target=self.server.serve_forever, daemon=True)
+        self.thread.start()
+        self.connection = http.client.HTTPConnection(
+            "127.0.0.1", self.server.server_address[1], timeout=2
+        )
+
+    def tearDown(self) -> None:
+        self.connection.close()
+        self.server.shutdown()
+        self.server.server_close()
+        self.thread.join(timeout=2)
+
+    def test_accepts_upload_message_and_native_result(self) -> None:
+        boundary = "clewdr-smoke-boundary"
+        upload = _multipart(
