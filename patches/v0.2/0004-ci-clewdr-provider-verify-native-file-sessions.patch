+    def test_rejects_missing_api_key(self) -> None:
+        boundary = "clewdr-missing-key"
+        status, payload = self._request(
+            "POST",
+            "/v1/files",
+            _multipart(
+                boundary,
+                [
+                    (
+                        "file",
+                        fixture.EXPECTED_FILENAME,
+                        fixture.EXPECTED_MIME,
+                        fixture.EXPECTED_BYTES,
+                    )
+                ],
+            ),
+            {"content-type": f"multipart/form-data; boundary={boundary}"},
+        )
+        self.assertEqual(status, 400)
+        self.assertIn("x-api-key", payload["detail"])
+
+    def test_rejects_invalid_message_protocol(self) -> None:
+        boundary = "clewdr-message-protocol"
+        status, _ = self._request(
+            "POST",
+            "/v1/files",
+            _multipart(
+                boundary,
+                [
+                    (
+                        "file",
+                        fixture.EXPECTED_FILENAME,
+                        fixture.EXPECTED_MIME,
+                        fixture.EXPECTED_BYTES,
+                    )
+                ],
+            ),
+            {
+                "content-type": f"multipart/form-data; boundary={boundary}",
+                "x-api-key": fixture.EXPECTED_API_KEY,
+            },
+        )
+        self.assertEqual(status, 200)
+
+        base_message = {
+            "messages": [
+                {
+                    "role": "user",
+                    "content": [
+                        {
+                            "type": "document",
+                            "source": {"type": "file", "file_id": fixture.FILE_ID},
+                        }
+                    ],
+                }
+            ],
+            "metadata": {"user_id": "cherry_topic_v1_test"},
+            "model": fixture.EXPECTED_MODEL,
+        }
+        cases = [
+            ({**base_message, "model": "wrong-model"}, "model"),
+            ({**base_message, "tools": []}, "strip tools"),
+            (
+                {
+                    **base_message,
+                    "messages": [
+                        {
+                            "role": "user",
+                            "content": [
+                                *base_message["messages"][0]["content"],
+                                {
+                                    "type": "document",
+                                    "source": {
+                                        "type": "base64",
+                                        "media_type": fixture.EXPECTED_MIME,
+                                        "data": "Q0xFV0RS",
+                                    },
+                                },
+                            ],
+                        }
+                    ],
+                },
+                "base64",
+            ),
+        ]
+        for payload, expected_detail in cases:
+            with self.subTest(expected_detail=expected_detail):
+                status, response = self._request(
+                    "POST",
+                    "/v1/messages",
+                    json.dumps(payload).encode(),
+                    {
+                        "content-type": "application/json",
+                        "x-api-key": fixture.EXPECTED_API_KEY,
+                    },
+                )
+                self.assertEqual(status, 400)
+                self.assertIn(expected_detail, response["detail"])
+
+    def _request(
+        self,
+        method: str,
+        path: str,
+        body: bytes | None = None,
+        headers: dict[str, str] | None = None,
+    ) -> tuple[int, dict[str, object]]:
+        self.connection.request(method, path, body, headers or {})
+        response = self.connection.getresponse()
+        return response.status, json.loads(response.read())
+
+
+def _multipart(boundary: str, parts: list[tuple[str, str, str, bytes]]) -> bytes:
+    body = bytearray()
+    for name, filename, mime_type, data in parts:
+        body.extend(f"--{boundary}\r\n".encode())
+        body.extend(
+            f'Content-Disposition: form-data; name="{name}"; filename="{filename}"\r\n'.encode()
+        )
+        body.extend(f"Content-Type: {mime_type}\r\n\r\n".encode())
+        body.extend(data)
+        body.extend(b"\r\n")
+    body.extend(f"--{boundary}--\r\n".encode())
+    return bytes(body)
+
+
+if __name__ == "__main__":
+    unittest.main()
