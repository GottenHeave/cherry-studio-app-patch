+
+    def test_rejects_duplicate_multipart_fields(self) -> None:
+        boundary = "clewdr-duplicate-boundary"
+        parts = [
+            ("file", fixture.EXPECTED_FILENAME, fixture.EXPECTED_MIME, fixture.EXPECTED_BYTES),
+            ("extra", "extra.bin", fixture.EXPECTED_MIME, b"extra"),
