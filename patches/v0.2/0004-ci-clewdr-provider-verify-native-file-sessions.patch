index 0000000..0d35415
--- /dev/null
+++ b/src/ai/runtime/clewdrRuntimeSmoke.ts
@@ -0,0 +1,114 @@
+import { createAgent } from '@cherrystudio/ai-core';
+import { fetch as expoFetch } from 'expo/fetch';
+
+import '../provider/factory';
+import type { AppProviderSettingsMap } from '../types';
+
+const SMOKE_SCHEME = 'cherrystudio:';
+const SMOKE_HOST = 'clewdr-runtime-smoke';
+const SMOKE_FILENAME = 'clewdr-runtime-smoke.bin';
+const SMOKE_MEDIA_TYPE = 'application/octet-stream';
+const SMOKE_BYTES = new Uint8Array([0x43, 0x4c, 0x45, 0x57, 0x44, 0x52]);
+const SMOKE_CLIENT_ID = '00000000-0000-4000-8000-000000000001';
+const runtimeFetch = ((
+  input: Parameters<typeof globalThis.fetch>[0],
+  init?: Parameters<typeof globalThis.fetch>[1],
+) => {
+  const url = input instanceof Request ? input.url : input.toString();
+  const expoInit = {
+    ...init,
+    body: init?.body ?? undefined,
+    headers: new Headers(init?.headers),
+  } as Parameters<typeof expoFetch>[1];
+  return expoFetch(url, expoInit);
+}) as typeof globalThis.fetch;
+
+export interface ClewdrRuntimeSmokeOptions {
+  endpoint: string;
+}
+
+interface SmokeResult {
+  status: 'success' | 'failure';
+  answer?: string;
+  error?: string;
+  rawTypes?: string[];
+}
+
+export function parseClewdrRuntimeSmokeUrl(url: string): ClewdrRuntimeSmokeOptions | null {
+  try {
+    const parsed = new URL(url);
+    if (parsed.protocol !== SMOKE_SCHEME || parsed.hostname !== SMOKE_HOST) return null;
+    if (parsed.pathname || parsed.hash) return null;
+    const queryKeys = [...parsed.searchParams.keys()];
+    if (queryKeys.length !== 1 || queryKeys[0] !== 'endpoint') return null;
+
+    const endpointValue = parsed.searchParams.get('endpoint');
+    if (!endpointValue) return null;
+    const endpoint = new URL(endpointValue);
+    if (endpoint.protocol !== 'http:' && endpoint.protocol !== 'https:') return null;
+    endpoint.search = '';
+    endpoint.hash = '';
+    endpoint.pathname = endpoint.pathname.replace(/\/+$/, '');
+    return { endpoint: endpoint.toString().replace(/\/$/, '') };
+  } catch {
+    return null;
+  }
+}
+
+export async function runClewdrRuntimeSmoke(options: ClewdrRuntimeSmokeOptions): Promise<void> {
+  let result: SmokeResult;
+  try {
+    const agent = await createAgent<AppProviderSettingsMap, 'clewdr'>({
+      agentSettings: { includeRawChunks: true, maxRetries: 0 },
+      modelId: 'claude-runtime-smoke',
+      providerId: 'clewdr',
+      providerSettings: {
+        apiKey: 'ci-runtime-smoke',
+        baseURL: `${options.endpoint}/v1`,
+        clientId: SMOKE_CLIENT_ID,
+        fetch: runtimeFetch,
+        sessionId: 'ci-runtime-topic',
+      },
+    });
+    const stream = await agent.stream({
+      messages: [
+        {
+          content: [
+            { text: 'Read the attached runtime smoke payload.', type: 'text' },
+            {
+              data: SMOKE_BYTES,
+              filename: SMOKE_FILENAME,
+              mediaType: SMOKE_MEDIA_TYPE,
+              type: 'file',
+            },
+          ],
+          role: 'user',
+        },
+      ],
+    });
+    let answer = '';
+    const rawTypes: string[] = [];
+    for await (const chunk of stream.fullStream) {
+      if (chunk.type === 'text-delta') answer += chunk.text;
+      if (chunk.type === 'raw') {
+        const rawValue = chunk.rawValue;
+        if (isRecord(rawValue) && typeof rawValue.type === 'string') {
+          rawTypes.push(rawValue.type);
+        }
+      }
+    }
+    result = { answer, rawTypes, status: 'success' };
+  } catch (error) {
+    result = { error: error instanceof Error ? error.message : String(error), status: 'failure' };
+  }
+
+  await expoFetch(`${options.endpoint}/result`, {
+    body: JSON.stringify(result),
+    headers: { 'content-type': 'application/json' },
+    method: 'POST',
+  });
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
