diff --git a/src/ai/provider/custom/__tests__/clewdrAnthropicCompatibility.test.ts b/src/ai/provider/custom/__tests__/clewdrAnthropicCompatibility.test.ts
new file mode 100644
index 0000000..d6065bd
--- /dev/null
+++ b/src/ai/provider/custom/__tests__/clewdrAnthropicCompatibility.test.ts
@@ -0,0 +1,230 @@
+import { createAnthropic } from '@ai-sdk/anthropic';
+import type { LanguageModelV3CallOptions, LanguageModelV3StreamPart } from '@ai-sdk/provider';
+import { streamText } from 'ai';
+
+import { createClewdrProvider } from '../clewdrProvider';
+
+const filePrompt: LanguageModelV3CallOptions = {
+  prompt: [
+    {
+      role: 'user',
+      content: [
+        {
+          data: new Uint8Array([0x50, 0x4b, 0x03, 0x04]),
+          filename: 'project.zip',
+          mediaType: 'application/zip',
+          type: 'file',
+        },
+      ],
+    },
+  ],
+};
+
+const textPrompt: LanguageModelV3CallOptions = {
+  prompt: [{ role: 'user', content: [{ text: 'hello', type: 'text' }] }],
+};
+
+async function captureRequest(
+  run: (fetch: typeof globalThis.fetch) => PromiseLike<unknown>,
+): Promise<Record<string, unknown>> {
+  let body: Record<string, unknown> | undefined;
+  const fetch = (async (_input: RequestInfo | URL, init?: RequestInit) => {
+    body = JSON.parse(String(init?.body));
+    return new Response('{}', { status: 200 });
+  }) as typeof globalThis.fetch;
+  try {
+    await run(fetch);
+  } catch (error) {
+    if (!body) throw error;
+  }
+  if (!body) throw new Error('no request was captured');
+  return body;
+}
+
+async function collectClewdrChunks(event: unknown) {
+  return collectClewdrStream(`data: ${JSON.stringify(event)}\n\n`);
+}
+
+function createEventStreamResponse(body: string): Response {
+  const encoded = new TextEncoder().encode(body);
+  return {
+    body: new ReadableStream<Uint8Array>({
+      start(controller) {
+        controller.enqueue(encoded);
+        controller.close();
+      },
+    }),
+    headers: new Headers({ 'content-type': 'text/event-stream' }),
+    ok: true,
+    status: 200,
+    statusText: 'OK',
+  } as Response;
+}
+
+async function collectClewdrStream(body: string) {
+  const fetch = (async () => createEventStreamResponse(body)) as typeof globalThis.fetch;
+  const result = await createClewdrProvider({ apiKey: 'test', fetch })
+    .languageModel('claude-sonnet-4-6')
+    .doStream(textPrompt);
+  const chunks: LanguageModelV3StreamPart[] = [];
+  for await (const chunk of result.stream) chunks.push(chunk);
+  return chunks;
+}
+
+describe('Clewdr Anthropic SDK boundary', () => {
+  it('serializes arbitrary Clewdr files as base64 documents', async () => {
+    const body = await captureRequest((fetch) =>
+      createClewdrProvider({ apiKey: 'test', baseURL: 'http://127.0.0.1:8484/v1', fetch })
+        .languageModel('claude-sonnet-4-6')
+        .doStream(filePrompt),
+    );
+
+    expect(body).toMatchObject({
+      messages: [
+        {
+          content: [
+            {
+              source: { data: 'UEsDBA==', media_type: 'application/zip', type: 'base64' },
+              title: 'project.zip',
+              type: 'document',
+            },
+          ],
+        },
+      ],
+    });
+  });
+
+  it('keeps arbitrary MIME rejection for official Anthropic', async () => {
+    await expect(
+      captureRequest((fetch) =>
+        createAnthropic({ apiKey: 'test', fetch })
+          .languageModel('claude-sonnet-4-6')
+          .doStream(filePrompt),
+      ),
+    ).rejects.toThrow('media type: application/zip');
+  });
+
+  it.each([
+    { type: 'conversation_ready' },
+    { message_limit: { type: 'within_limit' }, type: 'message_limit' },
+    {
+      delta: { cut_off: true, type: 'thinking_cut_off_delta' },
+      index: 0,
+      type: 'content_block_delta',
+    },
+    {
+      delta: {
+        display_content: { text: 'View the file', type: 'text' },
+        message: 'View the file',
+        type: 'tool_use_block_update_delta',
+      },
+      index: 2,
+      type: 'content_block_delta',
+    },
+  ])('passes Clewdr-specific event through as one raw chunk', async (event) => {
+    const chunks = await collectClewdrChunks(event);
+    expect(chunks.filter((chunk) => chunk.type === 'raw')).toEqual([
+      { rawValue: event, type: 'raw' },
+    ]);
+  });
+
+  it('keeps Clewdr event rejection for official Anthropic', async () => {
+    const event = { type: 'conversation_ready' };
+    const fetch = (async () =>
+      createEventStreamResponse(`data: ${JSON.stringify(event)}\n\n`)) as typeof globalThis.fetch;
+
+    await expect(
+      createAnthropic({ apiKey: 'test', fetch })
+        .languageModel('claude-sonnet-4-6')
+        .doStream(textPrompt),
+    ).rejects.toThrow('No matching discriminator');
+  });
+
+  it('reports malformed standard events instead of treating them as Clewdr extensions', async () => {
+    await expect(collectClewdrChunks({ message: {}, type: 'message_start' })).rejects.toThrow(
+      'Type validation failed',
+    );
+  });
+
+  it('continues through the AI SDK streamText chain after a Clewdr extension event', async () => {
+    const events = [
+      { type: 'conversation_ready' },
+      {
+        message: {
+          content: [],
+          id: 'msg-1',
+          model: 'claude-sonnet-4-6',
+          role: 'assistant',
+          usage: { input_tokens: 1 },
+        },
+        type: 'message_start',
+      },
+      { content_block: { text: '', type: 'text' }, index: 0, type: 'content_block_start' },
+      { delta: { text: 'answer', type: 'text_delta' }, index: 0, type: 'content_block_delta' },
+      { index: 0, type: 'content_block_stop' },
+      {
+        delta: { stop_reason: 'end_turn', stop_sequence: null },
+        type: 'message_delta',
+        usage: { output_tokens: 1 },
+      },
+      { type: 'message_stop' },
+    ];
+    const fetch = (async () =>
+      createEventStreamResponse(
+        events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join(''),
+      )) as typeof globalThis.fetch;
+    const result = streamText({
+      maxRetries: 0,
+      model: createClewdrProvider({ apiKey: 'test', fetch }).languageModel('claude-sonnet-4-6'),
+      prompt: 'hello',
+    });
+
+    await expect(result.text).resolves.toBe('answer');
+  });
+
+  it('keeps remote tool activity as raw chunks without emitting tool calls', async () => {
+    const events = [
+      {
+        message: {
+          content: [],
+          id: 'msg-1',
+          model: 'claude-sonnet-4-6',
+          role: 'assistant',
+          usage: { input_tokens: 1 },
+        },
+        type: 'message_start',
+      },
+      {
+        content_block: { id: 'toolu-1', input: {}, name: 'view', type: 'tool_use' },
+        index: 0,
+        type: 'content_block_start',
+      },
+      {
+        delta: { partial_json: '{"path":"a.txt"}', type: 'input_json_delta' },
+        index: 0,
+        type: 'content_block_delta',
+      },
+      { index: 0, type: 'content_block_stop' },
+      {
+        delta: { stop_reason: 'tool_use', stop_sequence: null },
+        type: 'message_delta',
+        usage: { output_tokens: 1 },
+      },
+      { type: 'message_stop' },
+    ];
+    const chunks = await collectClewdrStream(
+      events.map((event) => `data: ${JSON.stringify(event)}\n\n`).join(''),
+    );
+
+    expect(chunks.filter((chunk) => chunk.type === 'raw').map((chunk) => chunk.rawValue)).toEqual(
+      events,
+    );
+    expect(chunks.filter((chunk) => chunk.type.startsWith('tool-'))).toEqual([]);
+    expect(chunks).toContainEqual(
+      expect.objectContaining({
+        finishReason: { raw: 'tool_use', unified: 'stop' },
+        type: 'finish',
+      }),
+    );
+  });
+});
diff --git a/src/ai/provider/custom/__tests__/clewdrInstallation.test.ts b/src/ai/provider/custom/__tests__/clewdrInstallation.test.ts
