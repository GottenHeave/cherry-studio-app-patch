+import type { Provider } from '@/data/types/provider';
+
+import { providerToAiSdkConfig } from '../config';
+import '../factory';
+
+describe('Clewdr provider registry', () => {
+  it('publishes a Clewdr Anthropic endpoint with the isolated adapter family', () => {
+    const provider = new MobileRegistryLoader().findProvider('clewdr');
+
+    expect(provider).toMatchObject({
+      defaultChatEndpoint: ENDPOINT_TYPE.ANTHROPIC_MESSAGES,
+      endpointConfigs: {
+        [ENDPOINT_TYPE.ANTHROPIC_MESSAGES]: {
+          adapterFamily: 'clewdr',
+          baseUrl: 'http://127.0.0.1:8484/v1',
+        },
+      },
+      id: 'clewdr',
+      name: 'ClewdR',
+    });
+  });
+
+  it('routes the Clewdr endpoint to the Clewdr provider extension', async () => {
+    const provider: Provider = {
+      apiFeatures: {
+        arrayContent: true,
+        developerRole: true,
+        serviceTier: true,
+        streamOptions: true,
+        verbosity: false,
+      },
+      apiKeys: [],
+      authType: 'api-key',
+      defaultChatEndpoint: ENDPOINT_TYPE.ANTHROPIC_MESSAGES,
+      endpointConfigs: {
+        [ENDPOINT_TYPE.ANTHROPIC_MESSAGES]: {
+          adapterFamily: 'clewdr',
+          baseUrl: 'http://127.0.0.1:8484/v1',
+        },
+      },
+      id: 'clewdr',
+      isEnabled: true,
+      name: 'ClewdR',
+      presetProviderId: 'clewdr',
+      settings: {},
+    };
+    const model: Model = {
+      capabilities: [],
+      endpointTypes: [ENDPOINT_TYPE.ANTHROPIC_MESSAGES],
+      id: createUniqueModelId('clewdr', 'claude-sonnet-4-6'),
+      isDeprecated: false,
+      isEnabled: true,
+      isHidden: false,
+      modelId: 'claude-sonnet-4-6',
+      name: 'Claude Sonnet 4.6',
+      providerId: 'clewdr',
+      supportsStreaming: true,
+    };
+
+    const config = await providerToAiSdkConfig(provider, model, {
+      getAuthConfig: jest.fn(async () => null),
+      getRotatedApiKey: jest.fn(async () => 'secret'),
+    });
+
+    expect(config).toMatchObject({
+      providerId: 'clewdr',
+      providerSettings: {
+        apiKey: 'secret',
+        baseURL: 'http://127.0.0.1:8484/v1',
+      },
+    });
+
+    expect(extensionRegistry.has('clewdr')).toBe(true);
+    const sdkProvider = await extensionRegistry.createProvider('clewdr', config.providerSettings);
+    expect(sdkProvider.languageModel('claude-sonnet-4-6')).toMatchObject({
+      modelId: 'claude-sonnet-4-6',
+      specificationVersion: 'v3',
+    });
+  });
+});
