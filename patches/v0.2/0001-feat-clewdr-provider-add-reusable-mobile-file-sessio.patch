@@ -0,0 +1,81 @@
+const state: { exists: boolean; text: string; writes: string[] } = {
+  exists: false,
+  text: '',
+  writes: [],
+};
+
+const generatedInstallationId = '00000000-0000-4000-8000-000000000001';
+
+jest.mock('expo-crypto', () => ({ randomUUID: jest.fn(() => generatedInstallationId) }));
+
+jest.mock('expo-file-system', () => {
+  class MockFile {
+    get exists() {
+      return state.exists;
+    }
+
+    async text() {
+      return state.text;
+    }
+
+    write(value: string) {
+      state.exists = true;
+      state.text = value;
+      state.writes.push(value);
+    }
+  }
+
+  return {
+    File: MockFile,
+    Paths: { document: 'file:///documents' },
+  };
+});
+
+describe('Clewdr installation identity', () => {
+  beforeEach(() => {
