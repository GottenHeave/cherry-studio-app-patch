@@ -0,0 +1,48 @@
+import { createAgent } from '@cherrystudio/ai-core';
+
+import { Agent } from '../Agent';
+
+const mockAgentStream = jest.fn(async () => ({
+  toUIMessageStream: () =>
+    new ReadableStream({
+      start(controller) {
+        controller.close();
+      },
+    }),
+}));
+
+jest.mock('@cherrystudio/ai-core', () => ({
+  createAgent: jest.fn(async () => ({ stream: mockAgentStream })),
+}));
+
+const createAgentMock = createAgent as jest.MockedFunction<typeof createAgent>;
+
+async function consume(stream: ReadableStream): Promise<void> {
+  await stream.pipeTo(new WritableStream());
+}
+
+describe('Agent Clewdr streaming', () => {
+  beforeEach(() => {
+    jest.clearAllMocks();
+  });
+
+  it.each([
+    ['clewdr', true],
+    ['anthropic', undefined],
+  ] as const)('sets raw chunk visibility only for the %s provider', async (providerId, expected) => {
+    const agent = new Agent({
+      modelId: 'claude-sonnet-4-6',
+      providerId,
+      providerSettings: { apiKey: 'test' },
+    });
+
+    await consume(agent.stream([], new AbortController().signal));
+
+    const settings = createAgentMock.mock.calls[0][0].agentSettings;
+    if (expected) {
+      expect(settings.includeRawChunks).toBe(true);
+    } else {
+      expect(settings).not.toHaveProperty('includeRawChunks');
+    }
+  });
+});
