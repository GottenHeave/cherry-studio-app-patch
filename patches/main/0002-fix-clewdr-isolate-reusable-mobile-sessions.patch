diff --git a/src/aiCore/__tests__/index_new.test.ts b/src/aiCore/__tests__/index_new.test.ts
new file mode 100644
index 0000000..a742499
--- /dev/null
+++ b/src/aiCore/__tests__/index_new.test.ts
@@ -0,0 +1,59 @@
+import { fetch as expoFetch } from 'expo/fetch'
+
+import type { Model, Provider } from '@/types/assistant'
+
+import ModernAiProvider from '../index_new'
+
+jest.mock('expo/fetch', () => ({ fetch: jest.fn() }))
+
+jest.mock('../legacy/index', () => ({
+  __esModule: true,
+  default: jest.fn()
+}))
+
+jest.mock('../middleware/AiSdkMiddlewareBuilder', () => ({
+  buildAiSdkMiddlewares: jest.fn(() => [])
+}))
+
+jest.mock('../plugins/PluginBuilder', () => ({
+  buildPlugins: jest.fn(() => [])
+}))
+
+jest.mock('../provider/factory', () => ({
+  createAiSdkProvider: jest.fn()
+}))
+
+jest.mock('../provider/providerConfig', () => ({
+  getActualProvider: jest.fn(),
+  isModernSdkSupported: jest.fn(),
+  prepareSpecialProviderConfig: jest.fn(),
+  providerToAiSdkConfig: jest.fn(() => ({ providerId: 'clewdr', options: {} }))
+}))
+
+describe('ModernAiProvider transport', () => {
+  it('forwards Headers instances to expo fetch without dropping values', async () => {
+    jest.mocked(expoFetch).mockRejectedValue(new Error('stop after transport capture'))
+    const model = { id: 'claude-test', name: 'Claude Test', provider: 'clewdr' } as Model
+    const provider = {
+      id: 'clewdr',
+      name: 'Clewdr',
+      type: 'anthropic',
+      apiKey: 'secret',
+      apiHost: 'https://clewdr.example/v1/'
+    } as Provider
+    const instance = new ModernAiProvider(model, provider)
+    const customFetch = Reflect.get(instance, 'customFetch') as typeof expoFetch
+
+    await expect(
+      customFetch('https://clewdr.example/v1/messages', {
+        method: 'POST',
+        headers: new Headers({ authorization: 'Bearer secret', 'x-clewdr-protocol': 'explicit-v1' })
+      })
+    ).rejects.toThrow('stop after transport capture')
+
+    const forwardedInit = jest.mocked(expoFetch).mock.calls[0][1]
+    const forwardedHeaders = new Headers(forwardedInit?.headers)
+    expect(forwardedHeaders.get('authorization')).toBe('Bearer secret')
+    expect(forwardedHeaders.get('x-clewdr-protocol')).toBe('explicit-v1')
+  })
+})
