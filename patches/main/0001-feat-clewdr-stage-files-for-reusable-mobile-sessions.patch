+    apiKey,
+    clientId: 'installation-1',
+    topicId,
+    fetch: baseFetch
+  })
+}
+
+function messageCalls(baseFetch: jest.Mock) {
+  return baseFetch.mock.calls.filter(([input]) => String(input).endsWith('/messages'))
+}
+
+function uploadCalls(baseFetch: jest.Mock) {
+  return baseFetch.mock.calls.filter(([input]) => String(input).endsWith('/files'))
+}
+
+describe('Clewdr provider fetch', () => {
+  beforeEach(() => {
+    jest.clearAllMocks()
+  })
+
+  it('normalizes endpoints and derives deterministic, isolated session IDs', async () => {
+    expect(normalizeClewdrEndpoint('https://clewdr.example/api/v1///?ignored=1#fragment')).toBe(endpoint)
+
+    const first = await createClewdrSessionId('installation-1', endpoint, 'topic-1')
