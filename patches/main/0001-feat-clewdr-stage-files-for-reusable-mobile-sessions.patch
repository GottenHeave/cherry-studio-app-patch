@@ -0,0 +1,125 @@
+import { createAnthropic } from '@ai-sdk/anthropic'
+import type { LanguageModelV2CallOptions, LanguageModelV2StreamPart } from '@ai-sdk/provider'
+
+import { createClewdrProvider } from '../clewdrProvider'
+
+type FetchInput = Parameters<typeof fetch>[0]
+type FetchInit = Parameters<typeof fetch>[1]
+
+const filePrompt: LanguageModelV2CallOptions = {
+  prompt: [
+    {
+      role: 'user',
+      content: [
+        {
+          type: 'file',
+          data: new Uint8Array([0x50, 0x4b, 0x03, 0x04]),
+          mediaType: 'application/zip',
+          filename: 'project.zip'
+        }
+      ]
+    }
+  ]
+}
+
+const textPrompt: LanguageModelV2CallOptions = {
+  prompt: [{ role: 'user', content: [{ type: 'text', text: 'hello' }] }]
+}
+
+async function captureBody(
+  createModel: (fetchFunction: typeof fetch) => ReturnType<ReturnType<typeof createAnthropic>['languageModel']>
+) {
+  let requestBody: Record<string, unknown> | undefined
+  const fetchFunction = jest.fn(async (_input: FetchInput, init?: FetchInit) => {
+    requestBody = JSON.parse(String(init?.body))
+    return streamResponse({ type: 'message_stop' })
+  }) as typeof fetch
+
+  await createModel(fetchFunction).doStream(filePrompt)
+  return requestBody
+}
+
+function streamResponse(event: unknown): Response {
+  const payload = new TextEncoder().encode(`data: ${JSON.stringify(event)}\n\n`)
+  const body = new ReadableStream<Uint8Array>({
+    start(controller) {
+      controller.enqueue(payload)
+      controller.close()
+    }
+  })
+  return {
+    ok: true,
+    status: 200,
+    statusText: 'OK',
+    headers: new Headers({ 'content-type': 'text/event-stream' }),
+    body,
+    text: async () => new TextDecoder().decode(payload)
+  } as unknown as Response
+}
+
+async function streamChunks(providerName: 'clewdr' | 'anthropic.messages', event: unknown) {
+  const fetchFunction = (() => Promise.resolve(streamResponse(event))) as typeof fetch
+  const provider = createAnthropic({ apiKey: 'test', fetch: fetchFunction, name: providerName })
+  const result = await provider.languageModel('claude-test').doStream(textPrompt)
+  const chunks: LanguageModelV2StreamPart[] = []
+  const reader = result.stream.getReader()
+  while (true) {
+    const { done, value } = await reader.read()
+    if (done) break
+    chunks.push(value)
+  }
+  return chunks
+}
+
+describe('Clewdr Anthropic SDK boundary', () => {
+  it('serializes arbitrary Clewdr files without changing official Anthropic MIME validation', async () => {
+    const clewdrBody = await captureBody(fetchFunction =>
+      createClewdrProvider({
+        apiKey: 'test',
+        baseURL: 'https://clewdr.example/v1',
+        fetch: fetchFunction
+      }).languageModel('claude-test')
+    )
+
+    expect(clewdrBody).toMatchObject({
+      messages: [
+        {
+          content: [
+            {
+              type: 'document',
+              source: { type: 'base64', media_type: 'application/zip', data: 'UEsDBA==' },
+              title: 'project.zip'
+            }
+          ]
+        }
+      ]
+    })
+    await expect(
+      captureBody(fetchFunction =>
+        createAnthropic({
+          apiKey: 'test',
+          baseURL: 'https://api.anthropic.com/v1',
+          fetch: fetchFunction
+        }).languageModel('claude-test')
+      )
+    ).rejects.toThrow('media type: application/zip')
+  })
+
+  it.each([
+    { type: 'conversation_ready' },
+    {
+      type: 'content_block_delta',
+      index: 0,
+      delta: {
+        type: 'tool_use_block_update_delta',
+        message: 'Opening file',
+        display_content: { type: 'text', text: 'Opening file' }
+      }
+    }
+  ])('passes Clewdr-only event $type as raw while official Anthropic reports validation failure', async event => {
+    const clewdrChunks = await streamChunks('clewdr', event)
+    expect(clewdrChunks).toContainEqual({ type: 'raw', rawValue: event })
+
+    await expect(streamChunks('anthropic.messages', event)).rejects.toThrow('Type validation failed')
+  })
+})
