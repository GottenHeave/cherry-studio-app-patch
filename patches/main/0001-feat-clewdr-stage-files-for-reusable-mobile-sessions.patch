+import { SYSTEM_PROVIDERS_CONFIG } from '@/config/providers'
+import { storage } from '@/utils'
+
+import { getClewdrClientId } from '../clewdrProvider'
+import { prepareSpecialProviderConfig } from '../providerConfig'
+import { NEW_PROVIDER_CONFIGS } from '../providerInitialization'
+
+jest.mock('expo/fetch', () => ({ fetch: jest.fn() }))
+
+jest.mock('@/services/ProviderService', () => ({
+  getProviderByModel: jest.fn()
+}))
+
+jest.mock('@/integration/cherryai', () => ({
+  generateSignature: jest.fn()
+}))
+
+jest.mock('../factory', () => ({
+  getAiSdkProviderId: (provider: { id: string }) => provider.id
+}))
+
+describe('Clewdr provider integration', () => {
+  beforeEach(() => {
+    storage.delete('clewdr.installation_client_id')
+    jest.clearAllMocks()
+  })
+
+  it('registers an identifiable provider whose models route back to Clewdr', () => {
+    const provider = SYSTEM_PROVIDERS_CONFIG.clewdr
+
+    expect(provider).toMatchObject({
+      id: 'clewdr',
+      type: 'anthropic',
+      apiHost: 'http://127.0.0.1:8484/v1/'
+    })
+    expect(provider.models.length).toBeGreaterThan(0)
+    expect(provider.models.every(model => model.provider === 'clewdr')).toBe(true)
+    expect(NEW_PROVIDER_CONFIGS).toContainEqual(
+      expect.objectContaining({ id: 'clewdr', creatorFunctionName: 'createClewdrProvider' })
+    )
+  })
+
+  it('persists one installation ID and injects the topic before provider creation', async () => {
+    const firstClientId = getClewdrClientId()
+    const secondClientId = getClewdrClientId()
+    const baseFetch = jest.fn()
+    const config = {
+      providerId: 'clewdr',
+      options: { baseURL: 'http://127.0.0.1:8484/v1/', apiKey: 'secret', fetch: baseFetch }
+    } as Parameters<typeof prepareSpecialProviderConfig>[1]
+
+    await prepareSpecialProviderConfig(SYSTEM_PROVIDERS_CONFIG.clewdr, config, 'topic-1')
+
+    expect(firstClientId).toBe(secondClientId)
+    expect(storage.set).toHaveBeenCalledTimes(1)
+    expect(config.options).toMatchObject({
+      clientId: firstClientId,
+      sessionId: 'topic-1',
+      normalizedEndpoint: 'http://127.0.0.1:8484/v1/'
+    })
+    expect(config.options.fetch).toBe(baseFetch)
+  })
+
+  it('fails closed without a topic and leaves official Anthropic configuration unchanged', async () => {
+    const clewdrConfig = {
+      providerId: 'clewdr',
+      options: { baseURL: 'http://127.0.0.1:8484/v1/', apiKey: 'secret' }
+    } as Parameters<typeof prepareSpecialProviderConfig>[1]
+    await expect(prepareSpecialProviderConfig(SYSTEM_PROVIDERS_CONFIG.clewdr, clewdrConfig)).rejects.toThrow(
+      'requires a topic ID'
+    )
+
+    const officialProvider = SYSTEM_PROVIDERS_CONFIG.anthropic
+    const officialConfig = {
+      providerId: 'anthropic',
+      options: { baseURL: 'https://api.anthropic.com/v1/', apiKey: 'secret' }
+    } as Parameters<typeof prepareSpecialProviderConfig>[1]
+    const before = { ...officialConfig.options }
+
+    await prepareSpecialProviderConfig(officialProvider, officialConfig)
+
+    expect(officialConfig.options).toEqual(before)
+  })
+})
