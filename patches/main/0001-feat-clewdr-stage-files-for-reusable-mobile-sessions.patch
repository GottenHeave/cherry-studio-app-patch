+    await createTestFetch(
+      baseFetch as typeof fetch,
+      'topic-cache-a',
+      'key-b'
+    )(`${endpoint}/messages`, {
+      method: 'POST',
+      body: JSON.stringify(body)
+    })
+    await createClewdrFetch({
+      endpoint: 'https://other-clewdr.example/v1',
+      apiKey: 'key-a',
+      clientId: 'installation-1',
+      topicId: 'topic-cache-a',
+      fetch: baseFetch as typeof fetch
+    })('https://other-clewdr.example/v1/messages', { method: 'POST', body: JSON.stringify(body) })
+
+    expect(uploadCalls(baseFetch)).toHaveLength(4)
+  })
+
+  it('does not cache failed or invalid uploads', async () => {
+    const baseFetch = jest
+      .fn()
+      .mockResolvedValueOnce(jsonResponse({ unexpected: true }))
+      .mockResolvedValueOnce(jsonResponse(stagedFile('file_clewdr_valid')))
+      .mockResolvedValue(messageResponse())
+    const clewdrFetch = createTestFetch(baseFetch as typeof fetch, 'topic-invalid-upload')
+    const body = messagesBody({
+      messages: [
+        {
+          role: 'user',
+          content: [
+            {
+              type: 'document',
+              source: { type: 'base64', media_type: 'application/x-invalid', data: 'DQ4P' },
+              title: 'invalid.bin'
+            }
+          ]
+        }
+      ]
+    })
+
+    await expect(clewdrFetch(`${endpoint}/messages`, { method: 'POST', body: JSON.stringify(body) })).rejects.toThrow(
+      'invalid response'
+    )
+    await expect(
+      clewdrFetch(`${endpoint}/messages`, { method: 'POST', body: JSON.stringify(body) })
+    ).resolves.toBeDefined()
+
+    expect(uploadCalls(baseFetch)).toHaveLength(2)
+  })
+
+  it('propagates 409 without reset or retry', async () => {
+    const baseFetch = makeFetch({ messageStatuses: [409] })
+    const response = await createTestFetch(baseFetch as typeof fetch, 'topic-conflict')(`${endpoint}/messages`, {
+      method: 'POST',
+      body: JSON.stringify(messagesBody({ messages: [] }))
+    })
+
+    expect(response.status).toBe(409)
+    expect(messageCalls(baseFetch)).toHaveLength(1)
+    expect(baseFetch.mock.calls.some(([input]) => String(input).endsWith('/sessions/reset'))).toBe(false)
+  })
+
+  it('resets once on 410 and retries the staged body without uploading again', async () => {
+    const baseFetch = makeFetch({ messageStatuses: [410, 200], uploadIds: ['file_clewdr_reused'] })
+    const body = messagesBody({
+      messages: [
+        {
+          role: 'user',
+          content: [
+            {
+              type: 'document',
+              source: { type: 'base64', media_type: 'application/x-reset', data: 'EBES' },
+              title: 'reset.bin'
+            }
+          ]
+        }
+      ]
+    })
+
+    const response = await createTestFetch(baseFetch as typeof fetch, 'topic-expired')(`${endpoint}/messages`, {
+      method: 'POST',
+      body: JSON.stringify(body)
+    })
+
+    expect(response.status).toBe(200)
+    expect(uploadCalls(baseFetch)).toHaveLength(1)
+    expect(messageCalls(baseFetch)).toHaveLength(2)
+    expect(messageCalls(baseFetch)[0][1].body).toBe(messageCalls(baseFetch)[1][1].body)
+    const resetCall = baseFetch.mock.calls.find(([input]) => String(input).endsWith('/sessions/reset'))
+    expect(resetCall).toBeDefined()
+    const resetInit = resetCall?.[1]
+    expect(JSON.parse(String(resetInit?.body))).toEqual({
+      session_id: await createClewdrSessionId('installation-1', endpoint, 'topic-expired')
+    })
+  })
+
+  it('passes through non-message requests without cloning the request options', async () => {
+    const baseFetch = makeFetch()
+    const init: NonNullable<FetchInit> = { method: 'GET', headers: { accept: 'application/json' } }
+    const clewdrFetch = createTestFetch(baseFetch as typeof fetch, 'topic-passthrough')
+
+    await clewdrFetch(`${endpoint}/models`, init)
+
+    expect(baseFetch).toHaveBeenCalledWith(`${endpoint}/models`, init)
+    expect(uploadCalls(baseFetch)).toHaveLength(0)
+  })
+})
