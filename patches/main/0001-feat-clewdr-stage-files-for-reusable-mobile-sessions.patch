@@ -0,0 +1,349 @@
+import type * as NodeCrypto from 'node:crypto'
+
+import * as Crypto from 'expo-crypto'
+
+import { createClewdrFetch, createClewdrSessionId, normalizeClewdrEndpoint } from '../clewdrProvider'
+
+jest.mock('expo-crypto', () => ({
+  CryptoDigestAlgorithm: { SHA256: 'SHA-256' },
+  digest: jest.fn(async (_algorithm: string, data: Uint8Array) => {
+    const { createHash } = jest.requireActual('node:crypto') as typeof NodeCrypto
+    const digest = createHash('sha256').update(data).digest()
+    return digest.buffer.slice(digest.byteOffset, digest.byteOffset + digest.byteLength)
+  })
+}))
+
+type JsonObject = Record<string, unknown>
+type FetchInput = Parameters<typeof fetch>[0]
+type FetchInit = Parameters<typeof fetch>[1]
+
+const endpoint = 'https://clewdr.example/api/v1'
+
+function jsonResponse(body: unknown, status = 200): Response {
+  return new Response(JSON.stringify(body), {
+    status,
+    headers: { 'content-type': 'application/json' }
+  })
+}
+
+function messageResponse(status = 200): Response {
+  return new Response('event: message_stop\ndata: {"type":"message_stop"}\n\n', {
+    status,
+    headers: { 'content-type': 'text/event-stream' }
+  })
+}
+
+function stagedFile(id: string) {
+  return {
+    id,
+    type: 'file',
+    filename: 'payload.bin',
+    mime_type: 'application/octet-stream',
+    size_bytes: 3
+  }
+}
+
+function messagesBody(overrides: JsonObject = {}): JsonObject {
+  return {
+    model: 'claude-test',
+    messages: [
+      {
+        role: 'user',
+        content: [
+          { type: 'text', text: 'inspect these files' },
+          {
+            type: 'document',
+            source: { type: 'base64', media_type: 'application/x-custom', data: 'AQID' },
+            title: 'folder\\payload.bin'
+          },
+          {
+            type: 'image',
+            source: { type: 'base64', media_type: 'image/webp', data: 'BAUG' }
+          }
+        ]
+      },
+      { role: 'assistant', content: [{ type: 'text', text: 'prior assistant context' }] }
+    ],
+    tools: [{ name: 'local_tool' }],
+    tool_choice: { type: 'auto' },
+    metadata: { trace_id: 'trace-1' },
+    ...overrides
+  }
+}
+
+function makeFetch(options: { messageStatuses?: number[]; uploadIds?: string[] } = {}) {
+  const messageStatuses = [...(options.messageStatuses ?? [200])]
+  const uploadIds = [...(options.uploadIds ?? ['file_clewdr_document', 'file_clewdr_image'])]
+  return jest.fn(async (input: FetchInput, _init?: FetchInit) => {
+    const url = String(input)
+    if (url.endsWith('/files')) {
+      return jsonResponse(stagedFile(uploadIds.shift() ?? 'file_clewdr_extra'))
+    }
+    if (url.endsWith('/sessions/reset')) {
+      return jsonResponse({ ok: true })
+    }
+    return messageResponse(messageStatuses.shift() ?? 200)
+  })
+}
+
+function createTestFetch(baseFetch: typeof fetch, topicId = 'topic-1', apiKey = 'secret') {
