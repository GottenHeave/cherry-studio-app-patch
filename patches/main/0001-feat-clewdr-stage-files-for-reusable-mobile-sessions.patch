+
+    expect(first).toBe(repeated)
+    expect(first).toMatch(/^cherry_topic_v1_[a-f0-9]{64}$/)
+    expect(otherTopic).not.toBe(first)
+    expect(Crypto.digest).toHaveBeenCalled()
+  })
+
+  it('uploads document and image sources, preserves message content, injects metadata, and strips tools', async () => {
+    const baseFetch = makeFetch()
+    const clewdrFetch = createTestFetch(baseFetch as typeof fetch)
+    const signal = new AbortController().signal
+
+    const response = await clewdrFetch(`${endpoint}/messages`, {
+      method: 'POST',
+      headers: {
+        authorization: 'Bearer secret',
+        'content-type': 'application/json',
+        'content-length': '999'
+      },
+      signal,
+      body: JSON.stringify(messagesBody())
+    })
+
+    expect(await response.text()).toContain('message_stop')
+    expect(uploadCalls(baseFetch)).toHaveLength(2)
+    for (const [, uploadInit] of uploadCalls(baseFetch)) {
+      expect(uploadInit.signal).toBe(signal)
+      const headers = new Headers(uploadInit.headers)
+      expect(headers.get('authorization')).toBe('Bearer secret')
+      expect(headers.has('content-type')).toBe(false)
+      expect(headers.has('content-length')).toBe(false)
+      expect(uploadInit.body).toBeInstanceOf(FormData)
+    }
+
+    const sent = JSON.parse(messageCalls(baseFetch)[0][1].body as string)
+    expect(sent.messages).toEqual([
+      {
+        role: 'user',
+        content: [
+          { type: 'text', text: 'inspect these files' },
+          {
+            type: 'document',
+            source: { type: 'file', file_id: 'file_clewdr_document' },
+            title: 'folder\\payload.bin'
+          },
+          { type: 'image', source: { type: 'file', file_id: 'file_clewdr_image' } }
+        ]
+      },
+      { role: 'assistant', content: [{ type: 'text', text: 'prior assistant context' }] }
+    ])
+    expect(sent.metadata).toEqual({
+      trace_id: 'trace-1',
+      user_id: await createClewdrSessionId('installation-1', endpoint, 'topic-1')
+    })
+    expect(sent).not.toHaveProperty('tools')
+    expect(sent).not.toHaveProperty('tool_choice')
+    const messageHeaders = new Headers(messageCalls(baseFetch)[0][1].headers)
+    expect(messageHeaders.has('content-length')).toBe(false)
+  })
+
+  it('deduplicates concurrent and completed uploads for the same session', async () => {
+    const baseFetch = makeFetch({ uploadIds: ['file_clewdr_shared'] })
+    const clewdrFetch = createTestFetch(baseFetch as typeof fetch, 'topic-deduplicate')
+    const body = messagesBody({
+      messages: [
+        {
+          role: 'user',
+          content: [
+            {
+              type: 'document',
+              source: { type: 'base64', media_type: 'application/x-dedupe', data: 'BwgJ' },
+              title: 'same.bin'
+            }
+          ]
+        }
+      ]
+    })
+
+    await Promise.all([
+      clewdrFetch(`${endpoint}/messages`, { method: 'POST', body: JSON.stringify(body) }),
+      clewdrFetch(`${endpoint}/messages`, { method: 'POST', body: JSON.stringify(body) })
+    ])
+    await clewdrFetch(`${endpoint}/messages`, { method: 'POST', body: JSON.stringify(body) })
+
+    expect(uploadCalls(baseFetch)).toHaveLength(1)
+    for (const [, init] of messageCalls(baseFetch)) {
+      const sent = JSON.parse(init.body as string)
+      expect(sent.messages[0].content[0].source).toEqual({ type: 'file', file_id: 'file_clewdr_shared' })
+    }
+  })
+
+  it('isolates the upload cache by endpoint, session, and principal', async () => {
+    const baseFetch = makeFetch({ uploadIds: ['file_a', 'file_b', 'file_c', 'file_d'] })
+    const body = messagesBody({
+      messages: [
+        {
+          role: 'user',
+          content: [
+            {
+              type: 'document',
+              source: { type: 'base64', media_type: 'application/x-isolated', data: 'CgsM' },
+              title: 'isolated.bin'
+            }
+          ]
+        }
+      ]
+    })
+
+    await createTestFetch(
+      baseFetch as typeof fetch,
+      'topic-cache-a',
+      'key-a'
+    )(`${endpoint}/messages`, {
+      method: 'POST',
+      body: JSON.stringify(body)
+    })
+    await createTestFetch(
+      baseFetch as typeof fetch,
+      'topic-cache-b',
+      'key-a'
+    )(`${endpoint}/messages`, {
+      method: 'POST',
+      body: JSON.stringify(body)
