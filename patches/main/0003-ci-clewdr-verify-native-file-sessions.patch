--- /dev/null
+++ b/src/aiCore/__tests__/clewdrRuntimeSmoke.test.ts
@@ -0,0 +1,17 @@
+import { parseClewdrRuntimeSmokeUrl } from '../clewdrRuntimeSmoke'
+
+jest.mock('expo/fetch', () => ({ fetch: jest.fn() }))
+
+describe('Clewdr runtime smoke URL', () => {
+  it('accepts only the explicit smoke deep link with an HTTP endpoint', () => {
+    expect(
+      parseClewdrRuntimeSmokeUrl('cherry-studio://clewdr-runtime-smoke?endpoint=http%3A%2F%2F10.0.2.2%3A18484')
+    ).toEqual({ endpoint: 'http://10.0.2.2:18484' })
+
+    expect(parseClewdrRuntimeSmokeUrl('cherry-studio://settings?endpoint=http%3A%2F%2Flocalhost%3A18484')).toBeNull()
+    expect(
+      parseClewdrRuntimeSmokeUrl('https://clewdr-runtime-smoke?endpoint=http%3A%2F%2Flocalhost%3A18484')
+    ).toBeNull()
+    expect(parseClewdrRuntimeSmokeUrl('cherry-studio://clewdr-runtime-smoke?endpoint=file%3A%2F%2Ffixture')).toBeNull()
+  })
+})
