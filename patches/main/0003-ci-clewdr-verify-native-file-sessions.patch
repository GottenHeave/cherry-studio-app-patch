+import { render, waitFor } from '@testing-library/react-native'
+import React from 'react'
+import { Linking, Text } from 'react-native'
+
+import { parseClewdrRuntimeSmokeUrl, runClewdrRuntimeSmoke } from '@/aiCore/clewdrRuntimeSmoke'
+
+import { ClewdrRuntimeSmokeGate } from '../ClewdrRuntimeSmokeGate'
+
+jest.mock('@/aiCore/clewdrRuntimeSmoke', () => ({
+  parseClewdrRuntimeSmokeUrl: jest.fn(),
+  runClewdrRuntimeSmoke: jest.fn()
+}))
+
+describe('ClewdrRuntimeSmokeGate', () => {
+  const originalFlag = process.env.EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE
+
+  beforeEach(() => {
+    jest.clearAllMocks()
+  })
+
+  afterEach(() => {
+    jest.restoreAllMocks()
+  })
+
+  afterAll(() => {
+    process.env.EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE = originalFlag
+  })
+
+  it('leaves normal builds untouched without subscribing to links', () => {
+    delete process.env.EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE
+    const linkSpy = jest.spyOn(Linking, 'addEventListener')
+    const screen = render(
+      <ClewdrRuntimeSmokeGate>
+        <Text>normal app</Text>
+      </ClewdrRuntimeSmokeGate>
+    )
+
+    expect(screen.getByText('normal app')).toBeTruthy()
+    expect(linkSpy).not.toHaveBeenCalled()
+  })
+
+  it('runs only when the CI build receives the explicit smoke link', async () => {
+    process.env.EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE = '1'
+    const url = 'cherry-studio://clewdr-runtime-smoke?endpoint=http%3A%2F%2Flocalhost%3A18484'
+    const options = { endpoint: 'http://localhost:18484' }
+    jest.spyOn(Linking, 'getInitialURL').mockResolvedValue(url)
+    jest.spyOn(Linking, 'addEventListener')
+    jest.mocked(parseClewdrRuntimeSmokeUrl).mockReturnValue(options)
+    jest.mocked(runClewdrRuntimeSmoke).mockResolvedValue()
+    const screen = render(
+      <ClewdrRuntimeSmokeGate>
+        <Text>normal app</Text>
+      </ClewdrRuntimeSmokeGate>
+    )
+
+    await waitFor(() => expect(runClewdrRuntimeSmoke).toHaveBeenCalledWith(options))
+    expect(screen.queryByText('normal app')).toBeNull()
+  })
+})
