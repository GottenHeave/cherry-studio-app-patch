+import { streamText } from 'ai'
+import { fetch as expoFetch } from 'expo/fetch'
+
+import { createClewdrProvider } from './provider/clewdrProvider'
+
+const SMOKE_SCHEME = 'cherry-studio:'
+const SMOKE_HOST = 'clewdr-runtime-smoke'
+const SMOKE_FILENAME = 'clewdr-runtime-smoke.bin'
+const SMOKE_MEDIA_TYPE = 'application/octet-stream'
+const SMOKE_BYTES = new Uint8Array([0x43, 0x4c, 0x45, 0x57, 0x44, 0x52])
+const runtimeFetch = ((
+  input: Parameters<typeof globalThis.fetch>[0],
+  init?: Parameters<typeof globalThis.fetch>[1]
+) => {
+  const url = input instanceof Request ? input.url : input.toString()
+  const expoInit = { ...init, body: init?.body ?? undefined, headers: new Headers(init?.headers) } as Parameters<
+    typeof expoFetch
+  >[1]
+  return expoFetch(url, expoInit)
+}) as typeof globalThis.fetch
+
+interface ClewdrRuntimeSmokeOptions {
+  endpoint: string
+}
+
+interface SmokeResult {
+  status: 'success' | 'failure'
+  answer?: string
+  error?: string
+  rawTypes?: string[]
+}
+
+export function parseClewdrRuntimeSmokeUrl(url: string): ClewdrRuntimeSmokeOptions | null {
+  try {
+    const parsed = new URL(url)
+    if (parsed.protocol !== SMOKE_SCHEME || parsed.hostname !== SMOKE_HOST) return null
+
+    const endpointValue = parsed.searchParams.get('endpoint')
+    if (!endpointValue) return null
+    const endpoint = new URL(endpointValue)
+    if (endpoint.protocol !== 'http:' && endpoint.protocol !== 'https:') return null
+    endpoint.search = ''
+    endpoint.hash = ''
+    endpoint.pathname = endpoint.pathname.replace(/\/+$/, '')
+    return { endpoint: endpoint.toString().replace(/\/$/, '') }
+  } catch {
+    return null
+  }
+}
+
+export async function runClewdrRuntimeSmoke(options: ClewdrRuntimeSmokeOptions): Promise<void> {
+  let result: SmokeResult
+  try {
+    const provider = createClewdrProvider({
+      apiKey: 'ci-runtime-smoke',
+      baseURL: `${options.endpoint}/v1`,
+      clientId: 'ci-runtime-installation',
+      sessionId: 'ci-runtime-topic',
+      fetch: runtimeFetch
+    })
+    const stream = streamText({
+      model: provider.languageModel('claude-runtime-smoke'),
+      messages: [
+        {
+          role: 'user',
+          content: [
+            { type: 'text', text: 'Read the attached runtime smoke payload.' },
+            { type: 'file', data: SMOKE_BYTES, mediaType: SMOKE_MEDIA_TYPE, filename: SMOKE_FILENAME }
+          ]
+        }
+      ],
+      includeRawChunks: true
+    })
+    let answer = ''
+    const rawTypes: string[] = []
+    for await (const chunk of stream.fullStream) {
+      if (chunk.type === 'text-delta') answer += chunk.text
+      if (chunk.type === 'raw') {
+        const rawValue = chunk.rawValue
+        if (typeof rawValue === 'object' && rawValue !== null && 'type' in rawValue) {
+          const rawType = rawValue.type
+          if (typeof rawType === 'string') rawTypes.push(rawType)
+        }
+      }
+    }
+    result = { status: 'success', answer, rawTypes }
+  } catch (error) {
+    result = { status: 'failure', error: error instanceof Error ? error.message : String(error) }
+  }
+
+  await expoFetch(`${options.endpoint}/result`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify(result)
+  })
+}
