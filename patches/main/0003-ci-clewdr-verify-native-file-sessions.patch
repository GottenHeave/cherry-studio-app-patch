@@ -0,0 +1,33 @@
+import React, { type ReactNode, useEffect, useState } from 'react'
+import { ActivityIndicator, Linking } from 'react-native'
+
+import { parseClewdrRuntimeSmokeUrl, runClewdrRuntimeSmoke } from '@/aiCore/clewdrRuntimeSmoke'
+
+interface ClewdrRuntimeSmokeGateProps {
+  children: ReactNode
+}
+
+export function ClewdrRuntimeSmokeGate({ children }: ClewdrRuntimeSmokeGateProps) {
+  const [smokeUrl, setSmokeUrl] = useState<string | null>(null)
+  const enabled = process.env.EXPO_PUBLIC_CLEWDR_RUNTIME_SMOKE === '1'
+
+  useEffect(() => {
+    if (!enabled) return
+
+    const acceptUrl = (url: string | null) => {
+      if (url && parseClewdrRuntimeSmokeUrl(url)) setSmokeUrl(url)
+    }
+    const subscription = Linking.addEventListener('url', event => acceptUrl(event.url))
+    Linking.getInitialURL().then(acceptUrl)
+    return () => subscription.remove()
+  }, [enabled])
+
+  useEffect(() => {
+    if (!enabled || !smokeUrl) return
+    const options = parseClewdrRuntimeSmokeUrl(smokeUrl)
+    if (options) void runClewdrRuntimeSmoke(options)
+  }, [enabled, smokeUrl])
+
+  if (enabled && smokeUrl) return <ActivityIndicator size="large" />
+  return <>{children}</>
+}
